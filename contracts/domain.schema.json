{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "夜游联合运行中心领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROGRAM_CLEARED",
        "CAPACITY_OBSERVED",
        "ALERT_RAISED",
        "ZONE_RESTRICTED",
        "RESPONSE_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "night_program",
        "capacity_zone",
        "operational_alert",
        "joint_response"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
